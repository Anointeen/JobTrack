# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Build output ---
dist/
dist-ssr/
build/
*.local

# --- Environment / secrets ---
# Never commit real credentials. The template .env.example is tracked.
.env
.env.*
!.env.example

# --- Vite / tooling caches ---
.vite/
node_modules/.vite/
*.tsbuildinfo
.eslintcache
coverage/
.nyc_output/

# --- Supabase local development ---
# Migrations under supabase/migrations/ ARE tracked on purpose.
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/config.toml.bak

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- OS generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
