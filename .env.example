# JobTrack — Environment Template
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed.
#
# NOTE: Both variables below are required. If either is missing, the app falls
# back to a local demo mode that is DEVELOPMENT ONLY (see src/lib/supabase.ts).
# Production builds refuse to start without them.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public "anon" / publishable key.
# This key is safe to expose in a browser bundle — it is the client identity
# that Row Level Security policies are enforced against.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# WARNING: never add the `service_role` key (or any other server-only secret)
# to this file or to any VITE_-prefixed variable. Vite inlines every VITE_*
# value into the public client bundle, which would bypass Row Level Security
# entirely and expose all users' data.
# ---------------------------------------------------------------------------
